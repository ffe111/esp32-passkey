# Extra config for the serial-transport build (chips without USB OTG).
# UART0 carries CTAPHID frames, so nothing else may print to it.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# Keep receiving while the CTAP core writes flash (cache disabled): without
# this the 128-byte UART FIFO overruns and request bytes are lost.
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
